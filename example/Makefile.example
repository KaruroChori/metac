# Generated by metac from ./example/app.json
# Maually modified to work without installing `metac`.

# --- Core Configuration ---
TARGET = app
CC = gcc
OUTDIR = build
METAC_TOOL = ../metac

# --- Flags ---
CFLAGS = -I../include
LDFLAGS = 
DEPS_LDFLAGS = -lc -lX11 -lpng 
DEV_DEPS_LDFLAGS = -lz 

# --- Source File Configuration ---
SRCDIR = .
VPATH = $(SRCDIR)
SRC_FILES = file-a.c t/file-b.c

# --- Automatic File Lists ---
PREPROC_FILES = $(patsubst %.c,$(OUTDIR)/%.i,$(SRC_FILES))
GEN_FILES = $(patsubst %.c,$(OUTDIR)/%.gen.c,$(SRC_FILES))
OBJ_FILES = $(patsubst %.c,$(OUTDIR)/%.final.o,$(SRC_FILES))
METAC_LIB = $(OUTDIR)/metac_lib.so

.PHONY: all clean
.SUFFIXES:

all: $(OUTDIR)/$(TARGET)

# 1. Final Link: Links all final objects into the executable with runtime dependencies.
$(OUTDIR)/$(TARGET): $(OBJ_FILES)
	@echo "[LD] $@"
	$(CC) -o $@ $^ $(LDFLAGS) $(DEPS_LDFLAGS)

# 2. Final Compile
$(OUTDIR)/%.final.o: $(OUTDIR)/%.final.c
	@echo "[CC] $<"
	$(CC) $(CFLAGS) -c -o $@ $<

# 3. Metac Apply: Creates a .final.c file from a preprocessed source and the meta-library.
$(OUTDIR)/%.final.c: $(OUTDIR)/%.i $(METAC_LIB)
	@echo "[METAC-APPLY] $< -> $@"
	$(METAC_TOOL) --apply $(METAC_LIB) $< -o $@

# 4. Meta-Library Build: Links all generated code with metaprogramming dependencies.
$(METAC_LIB): $(GEN_FILES)
	@echo "[LIB] $@"
	$(CC) $(CFLAGS) -fPIC -shared -o $@ $^ $(DEV_DEPS_LDFLAGS) -L. -l:../libmetac.so

# 5. Metac Generate: Creates a .gen.c file from a preprocessed source file.
$(OUTDIR)/%.gen.c: $(OUTDIR)/%.i
	@echo "[METAC-GEN] $< -> $@"
	$(METAC_TOOL) $< -o $@

# 6. C Preprocess: Creates a .i file from an original .c source.
$(OUTDIR)/%.i: %.c
	@echo "[CPP] $< -> $@"
	@mkdir -p $(@D)
	$(CC) -E $(CFLAGS) $< -o $@ -D\$$COMPTIME_ERASE

# --- Cleanup Rule ---
clean:
	@echo "[CLEAN]"
	rm -rf $(OUTDIR) $(TARGET)
#.PRECIOUS: $(PREPROC_FILES) $(GEN_FILES) $(FINAL_C_FILES) $(OBJ_FILES) $(METAC_LIB)
